{
  "name": "ai-parts-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-firebase-config.mjs && tsc -b && vite build && node scripts/sync-root-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "build:verify": "tsc -b && vite build",
    "test:rules": "node scripts/firestore-rules.test.mjs",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "firebase": "^12.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}

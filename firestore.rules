rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function statePath() { return /databases/$(database)/documents/system/state; }
    function coordinated() {
      return signedIn() && getAfter(statePath()).data.schemaVersion == 2
        && getAfter(statePath()).data.revision == (exists(statePath()) ? get(statePath()).data.revision + 1 : 1)
        && (!(getAfter(statePath()).data.operation in ['ADMIN_RESTORE', 'ADMIN_RESET', 'LEGACY_MIGRATION']) || admin());
    }
    match /system/state {
      allow read: if signedIn();
      allow create, update: if coordinated();
    }
    match /tm_master/{id} {
      allow read: if signedIn();
      allow create: if coordinated() && request.resource.data.serialNo == id;
      allow update: if coordinated() && request.resource.data.serialNo == resource.data.serialNo && request.resource.data.serialNo == id;
      allow delete: if admin() && coordinated();
    }
    match /replacement_history/{id} {
      allow read: if signedIn();
      allow create, update: if coordinated() && request.resource.data.replacementId == id;
      allow delete: if admin() && coordinated();
    }
    match /settings/{id} { allow read: if signedIn(); allow create, update: if coordinated(); allow delete: if admin() && coordinated(); }
    match /severity_master/{id} { allow read: if signedIn(); allow write: if coordinated(); }
    match /risk_score/{id} { allow read: if signedIn(); }
    match /audit_log/{id} { allow read, create: if signedIn(); }
    match /backups/{id} { allow read, create: if signedIn(); match /chunks/{chunk} { allow read, create: if signedIn(); } }
    match /data_snapshots/{id} { allow read, create: if signedIn(); allow delete: if admin(); match /chunks/{chunk} { allow read, create: if signedIn(); } }
    match /uploaded_files/{id} { allow read, create: if signedIn(); }
  }
}
